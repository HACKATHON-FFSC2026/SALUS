<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. This file overrides src/main/res/xml/network_security_config.xml
  so a real device can reach the dev backend over cleartext HTTP on the LAN
  (e.g. http://192.168.1.20:8080). Release builds keep the strict config that
  only allows localhost/10.0.2.2, and production stays HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
