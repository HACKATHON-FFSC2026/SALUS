rules_version = '2';

// A user owns their profile and may edit only the fields listed in
// `_selfWritable`. roles / organizationId / isActive are administrative:
// leaving them out of the whitelist stops a client from self-promoting to
// admin. createdAt is pinned on first write.

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      function isSelf() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      function isAdmin() {
        return isSelf()
          && resource.data.roles.hasAny(['admin']);
      }

      function onlySelfWritable() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'email',
            'phoneNumber',
            'lastActiveAt',
            'safetyStatus',
            'safetyStatusUpdatedAt',
            'competencyTag'
          ]);
      }

      function validCreate() {
        return request.resource.data.keys().hasAll([
            'displayName',
            'email',
            'authProvider',
            'roles',
            'safetyStatus',
            'safetyStatusUpdatedAt',
            'lastActiveAt',
            'createdAt'
          ])
          && request.resource.data.roles == ['citizen'];
      }

      allow read: if isSelf() || isAdmin();

      allow create: if isSelf() && validCreate();

      allow update: if isAdmin()
        || (isSelf() && onlySelfWritable());

      allow delete: if isAdmin();
    }


    // =========================
    // SHELTERS
    // =========================
    match /shelters/{shelterId} {

      // Authenticated users can see shelters.
      allow read: if request.auth != null;

      // An authenticated user can create a shelter
      // only if they are recorded as its creator.
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      // The creator can update their own shelter.
      allow update: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      // The creator can delete their own shelter.
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }


    // =========================
    // SOS ALERTS
    // =========================
    match /SOS_alertes/{alertId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.userId == request.auth.uid
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'respondersCount',
                'status',
                'updatedAt'
              ])
            && request.resource.data.respondersCount
              == resource.data.respondersCount + 1
            && request.resource.data.status == 'inProgress'));
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // =========================
    // DEFAULT DENY
    // =========================
    // Nothing else is readable or writable from a client yet.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}