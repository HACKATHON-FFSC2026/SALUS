rules_version = '2';

// A user owns their profile and may edit only the fields listed in
// `_selfWritable`. roles / organizationId / isActive are administrative:
// leaving them out of the whitelist stops a client from self-promoting to
// admin. createdAt is pinned on first write.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny([role]);
    }

    function isAdmin() { return hasRole('admin'); }
    function isResponder() {
      return hasRole('organizationMember') || hasRole('shelterManager');
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      function isSelf() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      function isAdmin() {
        return signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
      }

      function onlySelfWritable() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'email',
            'phoneNumber',
            'lastActiveAt',
            'safetyStatus',
            'safetyStatusUpdatedAt',
            'competencyTag'
          ]);
      }

      function validCreate() {
        return request.resource.data.keys().hasAll([
            'displayName',
            'email',
            'authProvider',
            'roles',
            'safetyStatus',
            'safetyStatusUpdatedAt',
            'lastActiveAt',
            'createdAt'
          ])
          && request.resource.data.roles == ['citizen'];
      }

      allow read: if isSelf() || isAdmin();

      allow create: if isSelf() && validCreate();

      allow update: if isAdmin()
        || (isSelf() && onlySelfWritable());

      allow delete: if isAdmin();
    }


    // =========================
    // SHELTERS
    // =========================
    match /shelters/{shelterId} {

      // Authenticated users can see shelters.
      allow read: if request.auth != null;

      // An authenticated user can create a shelter
      // only if they are recorded as its creator.
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      // The creator can update their own shelter.
      allow update: if isAdmin() || (request.auth != null
        && resource.data.createdBy == request.auth.uid);

      // The creator can delete their own shelter.
      allow delete: if isAdmin() || (request.auth != null
        && resource.data.createdBy == request.auth.uid);
    }

    match /organizations/{organizationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /sos_alerts/{alertId} {

      function isOwner() {
        return signedIn() && resource.data.userId == request.auth.uid;
      }

      function changedOnly(keys) {
        return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(keys);
      }

      function isStillActive() {
        return resource.data.status == 'waiting'
          || resource.data.status == 'inProgress';
      }

      // La victime se déclare intervenant. Uniquement son propre uid, et
      // exactement un de plus: deux « Je réponds » ne doivent pas compter deux
      // fois la même personne.
      function joinsAsResponder() {
        return signedIn()
          && isStillActive()
          && changedOnly(['responderIds'])
          && request.resource.data.responderIds.size()
               == resource.data.responderIds.size() + 1
          && request.resource.data.responderIds.hasOnly(
               resource.data.responderIds.concat([request.auth.uid]));
      }

      // La victime annule, ou partage sa position tant que l'alerte est active.
      function victimUpdates() {
        return isOwner()
          && (
            (changedOnly(['status'])
              && request.resource.data.status == 'cancelled')
            || (isStillActive()
              && changedOnly(['location', 'geoCell', 'locationUpdatedAt']))
          );
      }

      // Un aidant identifié prend en charge ou clôt l'alerte. Seul lui peut
      // passer en `inProgress` / `resolved`: un citoyen qui répond garde
      // l'alerte en attente, sinon un simple tap ferait croire à la victime
      // que des secours sont en route.
      function responderUpdates() {
        return isResponder()
          && isStillActive()
          && changedOnly(['status', 'assignedOrganizationId', 'resolvedAt'])
          && request.resource.data.status in ['inProgress', 'resolved'];
      }

      // Les alertes actives sont visibles par tout utilisateur connecté: c'est
      // la file communautaire dans laquelle un citoyen répond (spec §1
      // « Répondre à une détresse »). Une alerte terminée ne reste lisible que
      // par la victime, les intervenants et l'admin: elle contient une position
      // et un motif de détresse qui n'ont plus lieu d'être exposés.
      allow read: if isAdmin() || isOwner() || isResponder()
        || (signedIn() && resource.data.status in ['waiting', 'inProgress']);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.responderIds.size() == 0;

      allow update: if isAdmin()
        || victimUpdates()
        || joinsAsResponder()
        || responderUpdates();

      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || isResponder();
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin() || (isResponder()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedBy'])
        && request.resource.data.status in ['reviewed', 'resolved']);
      allow delete: if isAdmin();
    }

    match /zones/{zoneId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isResponder()
        && request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAdmin() || (isResponder()
        && resource.data.createdBy == request.auth.uid);
    }

    match /help_responses/{responseId} {
      allow read: if isAdmin() || isResponder();
      allow create: if isResponder()
        && request.resource.data.responderId == request.auth.uid;
      allow update: if isAdmin() || (isResponder()
        && resource.data.responderId == request.auth.uid);
      allow delete: if isAdmin();
    }


    // =========================
    // DEFAULT DENY
    // =========================
    // Nothing else is readable or writable from a client yet.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
