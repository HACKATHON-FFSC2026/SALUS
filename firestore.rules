rules_version = '2';

// A user owns their profile and may edit only the fields listed in
// `_selfWritable`. roles / organizationId / isActive are administrative:
// leaving them out of the whitelist stops a client from self-promoting to
// admin. createdAt is pinned on first write.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny([role]);
    }

    function isAdmin() { return hasRole('admin'); }
    function isCitizen() { return hasRole('citizen'); }
    function isShelterManager() { return hasRole('shelterManager'); }
    function isOrganizationMember() { return hasRole('organizationMember'); }
    function ownsShelter() {
      return signedIn()
        && (resource.data.createdBy == request.auth.uid
          || resource.data.managedBy == request.auth.uid);
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      function isSelf() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      function onlySelfWritable() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'email',
            'phoneNumber',
            'lastActiveAt',
            'safetyStatus',
            'safetyStatusUpdatedAt',
            'competencyTag'
          ]);
      }

      function validCreate() {
        return request.resource.data.keys().hasAll([
            'displayName',
            'email',
            'authProvider',
            'roles',
            'safetyStatus',
            'safetyStatusUpdatedAt',
            'lastActiveAt',
            'createdAt'
          ])
          && request.resource.data.roles == ['citizen'];
      }

      allow read: if isSelf() || isAdmin();

      allow create: if isSelf() && validCreate();

      // Admins can approve role requests and manage account roles. Users can
      // only edit their own profile fields from the allowlist above.
      allow update: if isAdmin()
        || (isSelf() && onlySelfWritable());

      allow delete: if isAdmin();
    }


    // =========================
    // SHELTERS
    // =========================
    match /shelters/{shelterId} {

      // Shelter details are public so citizens can find help without signing in.
      allow read: if true;

      // Citizens and shelter managers can submit a proposal, which always
      // starts pending. Admins can add official, already validated shelters.
      allow create: if isAdmin()
        || (signedIn()
          && (isCitizen() || isShelterManager())
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.validationStatus == 'pending');

      // Managers can update operational details on their own shelter, but
      // cannot approve it, transfer ownership, or change its identity.
      allow update: if isAdmin()
        || (isShelterManager()
          && ownsShelter()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'capacityTotal', 'capacityOccupied', 'status', 'resources',
            'photos', 'address', 'location', 'updatedAt', 'unsafeReportsCount'
          ]));

      allow delete: if isAdmin();
    }

    match /organizations/{organizationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /sos_alerts/{alertId} {
      // Responders need a shared live queue to coordinate incoming distress calls.
      allow read: if isAdmin() || isOrganizationMember()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isOrganizationMember()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'assignedOrganizationId', 'resolvedAt', 'respondersCount'])
        && request.resource.data.status in ['inProgress', 'resolved', 'cancelled']);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelled';
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || isOrganizationMember()
        || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin() || (isOrganizationMember()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedBy'])
        && request.resource.data.status in ['reviewed', 'resolved']);
      allow delete: if isAdmin();
    }

    match /zones/{zoneId} {
      // Citizens need map data before logging in.
      allow read: if true;
      allow create: if isAdmin() || (isOrganizationMember()
        && request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAdmin() || (isOrganizationMember()
        && resource.data.createdBy == request.auth.uid);
    }

    match /help_responses/{responseId} {
      allow read: if isAdmin() || isOrganizationMember();
      allow create: if isOrganizationMember()
        && request.resource.data.responderId == request.auth.uid;
      allow update: if isAdmin() || (isOrganizationMember()
        && resource.data.responderId == request.auth.uid);
      allow delete: if isAdmin();
    }


    // =========================
    // DEFAULT DENY
    // =========================
    // Nothing else is readable or writable from a client yet.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
