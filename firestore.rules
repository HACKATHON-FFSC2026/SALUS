rules_version = '2';

// A user owns their profile and may edit only the fields listed in
// `_selfWritable`. roles / organizationId / isActive are administrative:
// leaving them out of the whitelist stops a client from self-promoting to
// admin. createdAt is pinned on first write.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny([role]);
    }

    function isAdmin() { return hasRole('admin'); }
    function isCitizen() { return hasRole('citizen'); }
    function isOrganizationMember() {
      return hasRole('organizationMember')
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId is string
        && exists(/databases/$(database)/documents/organizations/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId))
        && get(/databases/$(database)/documents/organizations/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId)).data.verified == true
        && get(/databases/$(database)/documents/organizations/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId)).data.isActive != false;
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      function isSelf() {
        return request.auth != null
          && request.auth.uid == userId;
      }

      function onlySelfWritable() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'email',
            'phoneNumber',
            'lastActiveAt',
            'safetyStatus',
            'safetyStatusUpdatedAt',
            'competencyTag'
          ]);
      }

      function validCreate() {
        return request.resource.data.keys().hasAll([
            'displayName',
            'email',
            'authProvider',
            'roles',
            'safetyStatus',
            'safetyStatusUpdatedAt',
            'lastActiveAt',
            'createdAt'
          ])
          && request.resource.data.roles == ['citizen'];
      }

      allow read: if isSelf() || isAdmin();

      allow create: if isSelf() && validCreate();

      // Admins can approve role requests and manage account roles. Users can
      // only edit their own profile fields from the allowlist above.
      allow update: if isAdmin()
        || (isSelf() && onlySelfWritable());

      allow delete: if isAdmin();
    }


    // =========================
    // SHELTERS
    // =========================
    match /shelters/{shelterId} {

      // Shelter details are public so citizens can find help without signing in.
      allow read: if true;

      // Citizens can submit a proposal, which always starts pending.
      // Admins can add official, already validated shelters.
      allow create: if isAdmin()
        || (signedIn()
          && isCitizen()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.validationStatus == 'pending');

      // Organization members validate citizen proposals without changing
      // operational or ownership fields. Admins manage all shelter fields.
      allow update: if isAdmin()
        || (isOrganizationMember()
          && resource.data.validationStatus == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['validationStatus', 'validatedBy'])
          && request.resource.data.validationStatus in ['validated', 'rejected']
          && request.resource.data.validatedBy == request.auth.uid);

      allow delete: if isAdmin();
    }

    match /organizations/{organizationId} {
      // Verified active organizations are listed in the public Help directory.
      // Their contact details are intentionally public for emergency assistance.
      allow read: if signedIn()
        || (resource.data.verified == true && resource.data.isActive == true);
      allow create, update, delete: if isAdmin();
    }

    match /sos_alerts/{alertId} {
      // Responders need a shared live queue to coordinate incoming distress calls.
      allow read: if isAdmin() || isOrganizationMember()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isOrganizationMember()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'assignedOrganizationId', 'resolvedAt', 'respondersCount'])
        && request.resource.data.status in ['inProgress', 'resolved', 'cancelled']);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelled';
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || isOrganizationMember()
        || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin() || (isOrganizationMember()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedBy'])
        && request.resource.data.status in ['reviewed', 'resolved']);
      allow delete: if isAdmin();
    }

    match /zones/{zoneId} {
      // Citizens need map data before logging in.
      allow read: if true;
      allow create: if isAdmin() || (isOrganizationMember()
        && request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAdmin() || (isOrganizationMember()
        && resource.data.createdBy == request.auth.uid);
    }

    match /help_responses/{responseId} {
      allow read: if isAdmin() || isOrganizationMember();
      allow create: if isOrganizationMember()
        && request.resource.data.responderId == request.auth.uid;
      allow update: if isAdmin() || (isOrganizationMember()
        && resource.data.responderId == request.auth.uid);
      allow delete: if isAdmin();
    }


    // =========================
    // DEFAULT DENY
    // =========================
    // Nothing else is readable or writable from a client yet.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
